# =============================================================================
# sack-train-ml — environment template
# =============================================================================
# Copy to `.env` (gitignored) for local dev, or to ~/.config/bscp/sack-train-ml.env
# for shared use across this repo's scripts.
#
# SECURITY:
#   - NEVER commit `.env` or any file containing real keys.
#   - SUPABASE_SERVICE_ROLE_KEY bypasses RLS — treat like a root password.
#   - For Colab notebooks, paste the service-role key into the prompt cell
#     (do NOT bake it into the notebook file).
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (model registry + run orchestration + artifact storage)
# -----------------------------------------------------------------------------
# From: Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-secret...

# From: Project Settings → General (used by `supabase link --project-ref`)
SUPABASE_PROJECT_REF=your-project-ref

# -----------------------------------------------------------------------------
# Cloudflare R2 (artifact + dataset storage; called by edge functions)
# -----------------------------------------------------------------------------
# Create at https://dash.cloudflare.com → R2 → Manage R2 API Tokens
# R2 gives 10 GB free + zero egress to internet (cheaper than Supabase Storage for artifacts).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=bscp-model-registry

# -----------------------------------------------------------------------------
# Training callback (HMAC signing for training-callback edge function)
# -----------------------------------------------------------------------------
# Random 32-byte hex string. Generate: openssl rand -hex 32
# Same secret must be set in the Colab notebook env when streaming metrics.
TRAINING_CALLBACK_SECRET=

# -----------------------------------------------------------------------------
# Training provider (optional — for headless CI training, not Colab)
# -----------------------------------------------------------------------------
TRAINING_PROVIDER_BASE_URL=
TRAINING_PROVIDER_API_KEY=

# -----------------------------------------------------------------------------
# Storage quotas
# -----------------------------------------------------------------------------
# Used by storage-usage edge function. Default 512 MB.
STORAGE_QUOTA_BYTES=536870912

# -----------------------------------------------------------------------------
# Training pipeline — local paths (for notebook / scripts)
# -----------------------------------------------------------------------------
MODEL_OUTPUT_ROOT=./artifacts
TRAIN_RUN_ROOT=./runs
DATA_ROOT=./data

# -----------------------------------------------------------------------------
# Hailo SDK (required for HEF compile stage; leave blank if compiling elsewhere)
# -----------------------------------------------------------------------------
HAILO_SDK_ROOT=

# -----------------------------------------------------------------------------
# Registry mode
# -----------------------------------------------------------------------------
# `supabase` = pull run_config + push metrics/artifacts via Supabase + R2 (default)
# `file`     = local-only mode for offline dev (reads ./configs, writes ./artifacts)
REGISTRY_MODE=supabase

# -----------------------------------------------------------------------------
# Colab notebook inputs (set at notebook runtime, not in .env)
# -----------------------------------------------------------------------------
# RUN_ID                  — UUID of the registry run; read from URL ?run_id=...
# SUPABASE_SERVICE_ROLE   — pasted via notebook prompt cell
